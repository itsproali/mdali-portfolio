# Contact form (Resend — https://resend.com)
# Without this the form returns a friendly "email me directly" error.
RESEND_API_KEY=

# Optional. The verified sender address enquiries go out from. Defaults to
# Resend's shared onboarding@resend.dev, which works immediately but lands in
# spam more often. Once mdali.dev is verified in Resend, set this to e.g.
# hello@mdali.dev. The visitor's name is used as the From display name and
# their address as Reply-To, so replies go straight back to them.
CONTACT_FROM_EMAIL=

# Enquiries are always delivered to siteConfig.email (itsproali@gmail.com).
